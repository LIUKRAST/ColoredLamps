{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contributors": [
        ""
    ],
    "contact": {
        "homepage": "https://liukrast.net/mods/${mod_id}",
        "issues": "https://github.com/LIUKRAST/ColoredLamps/issues",
        "sources": "https://github.com/LIUKRAST/ColoredLamps"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
          "net.liukrast.cl.ColoredLamps"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "another-mod": "*"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/pvn8zg9bNY",
                "modmenu.website": "https://liukrast.net/mods/colored_lamps",
                "modmenu.issues": "https://github.com/LIUKRAST/ColoredLamps/issues"
            },
            "update_checker": true
        }
    }
}
  